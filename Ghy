-- --- CREACIÓN DEL PANEL ---
local ScreenGui = Instance.new("ScreenGui", game.Players.LocalPlayer:WaitForChild("PlayerGui"))
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 100)
MainFrame.Position = UDim2.new(0.5, -100, 0.5, -50)
MainFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
MainFrame.Draggable = true -- Hace que el panel sea movible
MainFrame.Active = true

-- Variable de estado para el interruptor
local isHatching = false

-- Botón de control
local btn = Instance.new("TextButton", MainFrame)
btn.Size = UDim2.new(0, 180, 0, 50)
btn.Position = UDim2.new(0, 10, 0, 25)
btn.Text = "Hatch Dominus: OFF"
btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
btn.TextColor3 = Color3.new(1, 1, 1)

-- Lógica del botón (Toggle)
btn.MouseButton1Click:Connect(function()
    isHatching = not isHatching
    btn.Text = isHatching and "Hatch Dominus: ON" or "Hatch Dominus: OFF"
    btn.BackgroundColor3 = isHatching and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(80, 80, 80)
end)

-- --- BUCLE DE EJECUCIÓN (Hatch) ---
task.spawn(function()
    while true do
        if isHatching then
            pcall(function()
                local args = {buffer.fromstring("\006\vDominus Egg\006\017\001")}
                game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Comm"):WaitForChild("Net"):WaitForChild("RemoteSignal"):WaitForChild("RemoteSignal"):FireServer(unpack(args))
            end)
        end
        task.wait(0.2) -- Ajusta este tiempo si el juego te da error de "Rate Limit"
    end
end)
